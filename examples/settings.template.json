{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git -c * push *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push *)",
      "PowerShell(git -C * push *)",
      "PowerShell(git -c * push *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH}}",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{HOOKS_DIR}}\\push-merge-gate.ps1", "-Kind", "bash-push"],
            "if": "Bash(*git*push*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{PWSH}}",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{HOOKS_DIR}}\\push-merge-gate.ps1", "-Kind", "bash-merge"],
            "if": "Bash(*gh*merge*)",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH}}",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{HOOKS_DIR}}\\push-merge-gate.ps1", "-Kind", "ps-push"],
            "if": "PowerShell(*git*push*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{PWSH}}",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{HOOKS_DIR}}\\push-merge-gate.ps1", "-Kind", "ps-merge"],
            "if": "PowerShell(*gh*merge*)",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH}}",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{HOOKS_DIR}}\\telegram-approve.ps1"],
            "timeout": 330
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PWSH}}",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{HOOKS_DIR}}\\telegram-turn.ps1"],
            "timeout": 1860,
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
